# Copy to .env and fill in. Never commit the real .env.
# Secret used to sign login sessions. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
MINDSCREEN_SECRET_KEY=
# Optional: invite code that lets someone register as a Researcher (leave empty to disable researcher sign-up)
RESEARCHER_INVITE_CODE=
# Optional: password for demo accounts created by `python src/seed_demo.py` (random ones are printed if empty)
DEMO_PASSWORD=
# Set to 1 when serving over HTTPS so cookies are marked Secure
MINDSCREEN_HTTPS=0
# Where the database and uploaded originals live (default: ./instance)
# MINDSCREEN_INSTANCE=
